{
  "name": "zecron-cli",
  "version": "1.0.11",
  "description": "Scaffold a Vite + React project with optional packages",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "tailwindcss -i ./templates/setup-ui/input.css -o ./templates/setup-ui/style.css --minify",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npx tsx --test tests/unit.test.ts"
  },
  "bin": {
    "zecron": "dist/bin/index.js",
    "react": "dist/bin/index.js",
    "get": "dist/bin/get.js",
    "anshh": "dist/bin/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md"
  ],
  "keywords": [
    "cli",
    "react",
    "vite",
    "scaffold",
    "zecron"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "ora": "^7.0.1",
    "string-width": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
